{
  "expo": {
    "name": "loom_stay",
    "slug": "loom_stay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/others/icon.png",
    "scheme": "loomstay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.aryansrivastava.loomstay",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aryansrivastava.loomstay",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/others/android-icon-foreground.png",
        "backgroundImage": "./assets/images/others/android-icon-background.png",
        "monochromeImage": "./assets/images/others/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/others/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/others/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0f402e5c-b8fe-4ef3-bbed-158656d8c245"
      }
    }
  }
}
